# Metadata API keys
TMDB_API_KEY=
TVDB_API_KEY=
OMDB_API_KEY=
FANART_API_KEY=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trakt
DB_USER=trakt
DB_PASSWORD=

# Test admin credentials — needs CREATE/DROP DATABASE privileges (e.g. root or a dedicated test admin user)
DB_TEST_ADMIN_USER=root
DB_TEST_ADMIN_PASSWORD=

# Auth
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Scrobble API key (sent in X-Api-Key header by Kodi/Emby/Stremio)
SCROBBLE_API_KEY=

# Emby integration (for live progress polling)
EMBY_URL=
EMBY_API_KEY=

# Trakt.tv import (Phase 5 — register at trakt.tv/oauth/applications/new)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mobile app (also set as EAS secret for cloud builds: eas secret:create --name EXPO_PUBLIC_API_URL)
EXPO_PUBLIC_API_URL=http://localhost:3001
